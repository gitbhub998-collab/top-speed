# Backend
BACKEND_PORT=5750
JWT_SECRET=replace-with-a-random-secret
API_NINJAS_KEY=replace-with-api-key
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
ADMIN_EMAILS=admin@example.com
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_SECRET=replace-with-one-time-secret

# SMTP / email settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-password
TEAM_EMAIL=team@example.com

# Supabase configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Distributed rate limiting
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-token
